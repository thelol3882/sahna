{
  "name": "animated-web-deck-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "sahna": "scripts/sahna.mjs",
    "deck": "scripts/sahna.mjs"
  },
  "scripts": {
    "sahna": "node scripts/sahna.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "remote": "node remote/run.mjs",
    "record": "node remote/run.mjs --record",
    "remote:stop": "node remote/run.mjs --stop",
    "stop": "node remote/run.mjs --stop",
    "mix": "node remote/run.mjs --mix",
    "links": "node remote/run.mjs --links",
    "obs": "node remote/run.mjs --obs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "ws": "^8.18.0"
  }
}
